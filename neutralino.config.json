{
    "applicationId": "net.construct.editor",
    "applicationName": "Construct 3",
    "author": "Simple Web Wrapper",
    "description": "Construct 3",
    "applicationIcon": "./resources/icon.png",
    "version": "1.0.0",
    "defaultMode": "window",
    "port": 0,
    "url": "https://editor.construct.net/r449-6/",
    "enableServer": false,
    "enableNativeAPI": false,
    "tokenSecurity": "one-time",
    "logging": {
        "enabled": true,
